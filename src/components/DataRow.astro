---
export interface Item {
	value: string;
	valueClass?: string;
	label: string;
}
export interface Props {
	items: Item[];
	borderTop?: boolean;
	borderBottom?: boolean;
}
const { items, borderTop = false, borderBottom = true } = Astro.props;
---

<div
	class:list={[
		'grid',
		borderTop && 'border-t-2 border-white/[0.22]',
		borderBottom && 'border-b-2 border-white/[0.22]',
	]}
	style={`grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));`}
>
	{
		items.map((item, i) => (
			<div
				class:list={[
					'section-pad py-6',
					i !== 0 && 'border-l border-white/[0.16]',
				]}
			>
				<p class={`text-[clamp(26px,3.2vw,42px)] font-extrabold tracking-[-0.035em] ${item.valueClass ?? 'text-ink'}`}>
					{item.value}
				</p>
				<p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-silver-muted">
					{item.label}
				</p>
			</div>
		))
	}
</div>
