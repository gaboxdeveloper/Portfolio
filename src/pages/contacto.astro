---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const chips = [
	'Producto de punta a punta',
	'App móvil',
	'Diseño UX',
	'Dirección técnica',
	'Ciberseguridad (futuro)',
];

const datos = [
	{ label: 'Email', value: 'hola@rossystudio.com', href: 'mailto:hola@rossystudio.com' },
	{ label: 'Base', value: 'Uruguay · 100% remoto' },
	{ label: 'Zona horaria', value: 'GMT−3 · flexible con Europa y EEUU' },
	{ label: 'Disponibilidad', value: 'Tomando proyectos', dot: true },
];
---

<Layout
	title="Contacto"
	description="Contame el proyecto. Respondo personalmente en menos de 48 horas."
>
	<div class="flex min-h-screen flex-col">
		<Header showConsultar={false} sticky={false} />

		<section class="section-pad border-b-2 border-white/[0.22] py-[6vw]">
			<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">Contacto</span>
			<h1 class="mt-3 text-[clamp(40px,9vw,158px)] font-extrabold uppercase leading-[0.85] tracking-[-0.05em]">
				CONTAME<br />
				<span class="text-silver-muted">EL PROYECTO</span>
			</h1>
		</section>

		<section class="section-pad grid gap-14 py-[6vw]" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: start;">
			<div>
				<p class="max-w-[46ch] text-[15px] leading-[1.6] text-ink-secondary">
					Respondo personalmente en menos de 48 horas. Si el proyecto no es para mí, te lo digo derecho y, si puedo, te recomiendo a alguien.
				</p>
				<div class="mt-8">
					{
						datos.map((d, i) => (
							<div
								class:list={[
									'flex flex-wrap items-center gap-x-6 gap-y-1 py-4',
									i !== 0 && 'border-t border-white/[0.16]',
								]}
							>
								<span class="min-w-[110px] text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">
									{d.label}
								</span>
								{d.href ? (
									<a href={d.href} class="text-[16px] font-semibold text-ink transition-colors duration-150 hover:text-silver">
										{d.value}
									</a>
								) : (
									<span class="flex items-center gap-2 text-[16px] font-semibold text-ink">
										{d.dot && <span class="h-[7px] w-[7px] rounded-full bg-ink" />}
										{d.value}
									</span>
								)}
							</div>
						))
					}
				</div>
			</div>

			<div>
				<form id="contact-form" class="flex flex-col gap-[22px]" novalidate>
					<div class="flex flex-col gap-2">
						<label for="nombre" class="text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Nombre</label>
						<input
							id="nombre"
							name="nombre"
							type="text"
							required
							placeholder="Cómo te llamás"
							class="border-0 border-b border-white/[0.32] bg-transparent py-2 text-[16px] text-ink placeholder:text-placeholder focus:border-ink focus:outline-none"
						/>
					</div>
					<div class="flex flex-col gap-2">
						<label for="email" class="text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Email</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							placeholder="tu@empresa.com"
							class="border-0 border-b border-white/[0.32] bg-transparent py-2 text-[16px] text-ink placeholder:text-placeholder focus:border-ink focus:outline-none"
						/>
					</div>
					<div class="flex flex-col gap-2">
						<label for="empresa" class="text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Empresa o proyecto</label>
						<input
							id="empresa"
							name="empresa"
							type="text"
							placeholder="Opcional"
							class="border-0 border-b border-white/[0.32] bg-transparent py-2 text-[16px] text-ink placeholder:text-placeholder focus:border-ink focus:outline-none"
						/>
					</div>
					<div class="flex flex-col gap-3">
						<span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Qué necesitás</span>
						<div class="flex flex-wrap gap-2" id="chip-group">
							{
								chips.map((chip) => (
									<button
										type="button"
										class="chip border border-white/[0.32] px-4 py-2 text-[12px] font-semibold text-ink-secondary transition-colors duration-150"
										aria-pressed="false"
										data-chip={chip}
									>
										{chip}
									</button>
								))
							}
						</div>
					</div>
					<div class="flex flex-col gap-2">
						<label for="mensaje" class="text-[10px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Contame un poco</label>
						<textarea
							id="mensaje"
							name="mensaje"
							rows="5"
							required
							placeholder="Qué querés construir, en qué etapa está y para cuándo lo necesitás."
							class="border border-white/[0.32] bg-transparent p-3 text-[16px] text-ink placeholder:text-placeholder focus:border-ink focus:outline-none"
						></textarea>
					</div>
					<div class="mt-2 flex flex-wrap items-center gap-5">
						<button
							type="submit"
							class="bg-ink px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-base transition-colors duration-150 hover:bg-white"
						>
							{`Enviar consulta →`}
						</button>
						<span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-silver-muted">Respuesta en 48h</span>
					</div>
				</form>

				<div id="contact-success" class="hidden bg-panel p-[44px_38px]">
					<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">Consulta enviada</span>
					<h2 id="success-heading" class="mt-3 text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">
						Gracias
					</h2>
					<p class="mt-4 max-w-[46ch] text-[15px] leading-[1.6] text-ink-secondary">
						Te escribo a la dirección que dejaste en menos de 48 horas. Si es urgente, respondeme el mail directamente.
					</p>
					<button
						type="button"
						id="reset-form"
						class="mt-6 border border-white/[0.32] px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-ink transition-colors duration-150 hover:bg-white/[0.08]"
					>
						Enviar otra consulta
					</button>
				</div>
			</div>
		</section>

		<div class="mt-auto">
			<Footer />
		</div>
	</div>
</Layout>

<style>
	.chip[aria-pressed='true'] {
		background: #f2f2f2;
		color: #0b0b0b;
		border-color: #f2f2f2;
	}
	.chip[aria-pressed='false']:hover {
		background: rgba(255, 255, 255, 0.08);
	}
</style>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const success = document.getElementById('contact-success') as HTMLElement;
	const successHeading = document.getElementById('success-heading') as HTMLElement;
	const resetBtn = document.getElementById('reset-form') as HTMLButtonElement;
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const pressed = chip.getAttribute('aria-pressed') === 'true';
			chip.setAttribute('aria-pressed', String(!pressed));
		});
	});

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		const nombre = (form.querySelector('#nombre') as HTMLInputElement).value.trim();
		const primerNombre = nombre.split(' ')[0] || '';
		successHeading.textContent = `Gracias, ${primerNombre}`;
		form.classList.add('hidden');
		success.classList.remove('hidden');
	});

	resetBtn?.addEventListener('click', () => {
		form.reset();
		chips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
		success.classList.add('hidden');
		form.classList.remove('hidden');
	});
</script>
