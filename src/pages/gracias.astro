---
import Layout from '../layouts/Layout.astro';
---

<Layout title="¡Gracias! · Ideago" description="Recibimos tu mensaje.">
	<main class="simple">
		<a href="/" class="simple-logo" aria-label="Ideago, inicio"><img src="/logo/ideago.png" alt="Ideago" width="105" height="36" /></a>
		<span class="simple-label">Mensaje enviado</span>
		<h1 class="simple-title">¡Gracias!<br /><span>Ya estamos en marcha.</span></h1>
		<p class="simple-text">Recibimos tu idea. Te respondemos pronto con próximos pasos.</p>
		<a href="/" class="simple-btn">Volver al inicio →</a>
	</main>
</Layout>

