---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DataRow from '../components/DataRow.astro';
import ImageFrame from '../components/ImageFrame.astro';
import CtaClose from '../components/CtaClose.astro';

// Configuración editable del home.
const disponible = true;
const mostrarCiber = true;
const anioCiber = '2027';

const servicios = [
	{
		num: '01',
		title: 'Producto de punta a punta',
		desc: 'De la idea cruda a la app publicada: definición, alcance, diseño, desarrollo y release, con una sola cabeza sosteniendo la coherencia.',
	},
	{
		num: '02',
		title: 'Aplicaciones móviles',
		desc: 'Mi especialidad. React Native y Expo, arquitectura pensada para crecer y una experiencia que no se siente hecha a los apurones.',
	},
	{
		num: '03',
		title: 'Diseño UX con criterio',
		desc: 'Flujos, jerarquía y decisiones defendibles. Menos pantallas bonitas, más caminos que la gente completa sin preguntar nada.',
	},
	{
		num: '04',
		title: 'Dirección técnica',
		desc: 'Para equipos que ya están construyendo y necesitan alguien que ordene el rumbo, revise decisiones y frene lo que no hay que hacer.',
	},
];
---

<Layout
	title="Producto digital hecho bien"
	description="RossyStudio: diseño y desarrollo de aplicaciones móviles con visión de producto. Un estudio unipersonal, operado en remoto desde Uruguay."
>
	<Header />

	<section class="section-pad border-b-2 border-white/[0.22] pb-0 pt-[5vw]">
		<div class="flex flex-wrap justify-between gap-x-8 gap-y-2 pb-6">
			<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">
				Estudio de producto digital
			</span>
			<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">
				Mobile first
			</span>
			<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">
				Uruguay
			</span>
			<span class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-ink">
				<span class="h-[7px] w-[7px] rounded-full bg-ink"></span>
				{disponible ? 'Tomando proyectos' : 'Agenda completa'}
			</span>
		</div>

		<h1 class="text-[clamp(46px,11.2vw,184px)] font-extrabold uppercase leading-[0.85] tracking-[-0.05em]">
			PRODUCTO<br />
			<span class="text-silver-muted">DIGITAL</span><br />
			HECHO BIEN
		</h1>

		<div class="mt-10 grid gap-10 pb-[6.5vw]" style="grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 40px;">
			<p class="max-w-[32ch] text-[clamp(16px,1.6vw,23px)] font-medium leading-[1.45]">
				Pienso, diseño y construyo aplicaciones móviles con mi propia visión del producto. Solo, o dirigiendo el equipo que haga falta.
			</p>
			<div>
				<p class="max-w-[42ch] text-[15px] leading-[1.6] text-ink-secondary">
					Pensar, decidir y construir son la misma tarea. Por eso acá no hay traspaso de manos: la persona que define el producto es la que lo escribe.
				</p>
				<div class="mt-6 flex flex-wrap gap-4">
					<a
						href="/contacto"
						class="bg-ink px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-base transition-colors duration-150 hover:bg-white"
					>
						Enviar consulta {'→'}
					</a>
					<a
						href="/trabajo/etool"
						class="border border-white/[0.32] px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-ink transition-colors duration-150 hover:bg-white/[0.08]"
					>
						Ver el caso eTool
					</a>
				</div>
			</div>
		</div>
	</section>

	<DataRow
		borderBottom={true}
		items={[
			{ value: 'iOS/Android', valueClass: 'text-silver-muted', label: 'Una base de código' },
			{ value: '1', label: 'Responsable del proyecto' },
			{ value: '48h', label: 'Tiempo de respuesta' },
			{ value: 'E2E', valueClass: 'text-silver-muted', label: 'Idea, diseño, código, release' },
		]}
	/>

	<section id="servicios" class="section-pad py-[6.5vw]">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">QUÉ HAGO</h2>
			<span class="pb-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">{'01 — Servicios'}</span>
		</div>
		<div>
			{
				servicios.map((s, i) => (
					<a
						href="/servicios"
						class:list={[
							'grid items-center gap-4 py-6 transition-colors duration-150 hover:bg-white/[0.04]',
							i === servicios.length - 1 ? 'border-b-2 border-white/[0.22]' : 'border-b border-white/[0.16]',
						]}
						style="grid-template-columns: 64px minmax(0,1fr) minmax(0,1.25fr);"
					>
						<span class="text-[12px] font-extrabold text-silver-muted">{s.num}</span>
						<h3 class="text-[clamp(18px,2.1vw,27px)] font-extrabold uppercase tracking-[-0.02em]">{s.title}</h3>
						<p class="text-[15px] leading-[1.6] text-ink-secondary">{s.desc}</p>
					</a>
				))
			}
		</div>
	</section>

	<section id="etool" class="section-pad pb-[6.5vw]">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-[clamp(28px,4vw,52px)] font-extrabold tracking-[-0.035em]">eTool</h2>
			<span class="pb-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">{'02 — Caso'}</span>
		</div>
		<div class="grid border border-white/[0.16]" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));">
			<div class="p-[38px]">
				<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">{'App móvil · Ganadería'}</span>
				<h3 class="mt-3 text-[clamp(18px,2.1vw,27px)] font-extrabold uppercase tracking-[-0.02em]">
					La gestión del campo, en el bolsillo del productor
				</h3>
				<p class="mt-4 max-w-[46ch] text-[15px] leading-[1.6] text-ink-secondary">
					Una app para cargar animales, pasturas y suplementación con el mínimo esfuerzo, y convertir esos datos en proyecciones que ayudan a decidir.
				</p>
				<div class="mt-6 grid grid-cols-2 border-t border-white/[0.16] pt-4">
					<div class="border-r border-white/[0.16] pr-4">
						<p class="text-[18px] font-extrabold tracking-[-0.02em]">iOS/And</p>
						<p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-silver-muted">{'Expo · React Native'}</p>
					</div>
					<div class="pl-4">
						<p class="text-[18px] font-extrabold tracking-[-0.02em]">4 módulos</p>
						<p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Datos y proyecciones</p>
					</div>
				</div>
				<a
					href="/trabajo/etool"
					class="mt-8 inline-block border border-white/[0.32] px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-ink transition-colors duration-150 hover:bg-white/[0.08]"
				>
					Caso completo {'→'}
				</a>
			</div>
			<div class="bg-panel p-[38px]">
				<ImageFrame ratio="9/19" label="Captura: eTool" class="max-w-[220px]" />
				<ImageFrame ratio="9/19" label="Captura: eTool" class="mt-9 max-w-[220px]" />
			</div>
		</div>
	</section>

	<section id="sobre" class="section-pad border-t-2 border-white/[0.22] py-[6.5vw]">
		<div class="grid gap-10" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));">
			<div>
				<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">{'03 — El estudio'}</span>
				<h2 class="mt-3 text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">
					UN ESTUDIO DE UNA PERSONA, CON CRITERIO DE EQUIPO
				</h2>
			</div>
			<div>
				<p class="text-[15px] leading-[1.6] text-ink-secondary">
					No hay capas intermedias: quien habla con vos es quien diseña, escribe el código y responde cuando algo se rompe. Eso hace que las decisiones sean rápidas y consistentes de punta a punta.
				</p>
				<p class="mt-4 text-[15px] leading-[1.6] text-ink-secondary">
					Trabajo en remoto desde Uruguay, pero cuando el proyecto lo pide, viajo: reuniones presenciales y visitas a las instalaciones del cliente para entender el trabajo donde realmente pasa. Y si hacen falta más manos, sumo especialistas y los dirijo yo.
				</p>
				<a
					href="/estudio"
					class="mt-6 inline-block border border-white/[0.32] px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-ink transition-colors duration-150 hover:bg-white/[0.08]"
				>
					Cómo trabajo {'→'}
				</a>
			</div>
		</div>
	</section>

	{
		mostrarCiber && (
			<section class="section-pad pb-[6.5vw]">
				<div class="grid border border-white/[0.16] bg-panel" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));">
					<div class="p-[38px]">
						<span class="inline-block border border-white/[0.32] px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-silver">
							Próxima línea
						</span>
						<h3 class="mt-4 text-[clamp(24px,3vw,36px)] font-extrabold uppercase tracking-[-0.03em]">Ciberseguridad</h3>
						<p class="mt-3 max-w-[46ch] text-[15px] leading-[1.6] text-ink-secondary">
							Una segunda línea de servicio para auditar y proteger los productos que construyo y los de otros equipos. Todavía no está abierta.
						</p>
					</div>
					<div class="flex items-end justify-start p-[38px] sm:justify-end">
						<div class="text-right">
							<p class="text-[clamp(46px,7vw,96px)] font-extrabold leading-none tracking-[-0.035em] text-ghost">{anioCiber}</p>
							<p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.16em] text-silver-muted">Apertura estimada</p>
						</div>
					</div>
				</div>
			</section>
		)
	}

	<CtaClose
		heading="CONTAME QUÉ QUERÉS CONSTRUIR"
		paragraph="Respondo personalmente en menos de 48 horas. Si el proyecto no es para mí, te lo digo derecho."
		primaryLabel={`Enviar consulta →`}
		primaryHref="/contacto"
	/>

	<Footer />
</Layout>
