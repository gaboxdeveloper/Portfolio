---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada · Ideago" description="La página que buscás no existe.">
	<main class="simple">
		<a href="/" class="simple-logo" aria-label="Ideago, inicio"><img src="/logo/ideago.png" alt="Ideago" width="105" height="36" /></a>
		<span class="simple-label">Error 404</span>
		<h1 class="simple-title">Esta idea<br /><span>no existe (todavía).</span></h1>
		<p class="simple-text">La página que buscás no está acá.</p>
		<a href="/" class="simple-btn">Volver al inicio →</a>
	</main>
</Layout>
