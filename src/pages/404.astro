---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada" description="La página que buscás no existe.">
	<div class="flex min-h-screen flex-col">
		<Header />
		<section class="section-pad flex flex-1 flex-col justify-center py-[10vw]">
			<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">Error 404</span>
			<h1 class="mt-3 text-[clamp(46px,11.2vw,184px)] font-extrabold uppercase leading-[0.85] tracking-[-0.05em]">
				NO ESTÁ<br />
				<span class="text-silver-muted">ACÁ</span>
			</h1>
			<a
				href="/"
				class="mt-8 inline-block w-fit bg-ink px-7 py-4 text-[13px] font-extrabold uppercase tracking-[0.14em] text-base transition-colors duration-150 hover:bg-white"
			>
				{`Volver al inicio →`}
			</a>
		</section>
		<Footer />
	</div>
</Layout>
