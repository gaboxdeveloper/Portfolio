---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DataRow from '../../components/DataRow.astro';
import ImageFrame from '../../components/ImageFrame.astro';
import CtaClose from '../../components/CtaClose.astro';

const modulos = [
	{
		num: 'MOD 01',
		title: 'Animales',
		desc: 'Categorías, cabezas y kilos vivos. La base de cualquier cálculo de consumo.',
	},
	{
		num: 'MOD 02',
		title: 'Pasturas',
		desc: 'Superficie y disponibilidad por lote, cargadas con el mínimo de campos posible.',
	},
	{
		num: 'MOD 03',
		title: 'Suplementos',
		desc: 'Otros alimentos y su stock, para completar la dieta cuando la pastura no alcanza.',
	},
	{
		num: 'MOD 04',
		title: 'Proyecciones',
		desc: 'Gráficos de consumo y disponibilidad en el tiempo. Acá el dato se vuelve decisión.',
	},
];

const decisiones = [
	{
		strong: 'Una sola base de código',
		rest: ' para iOS y Android sobre Expo, con builds gestionados por EAS.',
	},
	{
		strong: 'Sesión y roles desde el arranque',
		rest: ' — credenciales en almacenamiento seguro, invitaciones por establecimiento y ruteo por rol.',
	},
	{
		strong: 'Gráficos nativos',
		rest: ' dibujados en el dispositivo, no imágenes.',
	},
	{
		strong: 'Interfaz pensada para el campo',
		rest: ' — pocas pantallas, objetivos grandes, formularios cortos, usable con una mano y sin buena señal.',
	},
];
---

<Layout
	title="Caso eTool"
	description="eTool: la gestión del campo, en el bolsillo del productor. Animales, pasturas, suplementación y proyecciones en una sola app."
>
	<Header />

	<section class="section-pad border-b-2 border-white/[0.22] pb-[6vw] pt-[5vw]">
		<div class="flex flex-wrap justify-between gap-x-8 gap-y-2 pb-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">
			<span>Caso 01</span>
			<span>App móvil · Ganadería</span>
			<span>iOS · Android</span>
			<span>En desarrollo activo</span>
		</div>
		<h1 class="text-[clamp(46px,11.2vw,184px)] font-extrabold leading-[0.85] tracking-[-0.05em]">eTool</h1>
		<p class="mt-6 max-w-[54ch] text-[clamp(17px,2vw,28px)] leading-[1.4]">
			La gestión del campo, en el bolsillo del productor: animales, pasturas, suplementación y proyecciones en una sola app.
		</p>
	</section>

	<DataRow
		borderTop={false}
		items={[
			{ value: 'Producto, diseño y desarrollo', valueClass: 'text-[20px]', label: 'Mi rol' },
			{ value: 'Dos personas (mayoría propia)', valueClass: 'text-[20px]', label: 'Equipo' },
			{ value: 'React Native / Expo · EAS', valueClass: 'text-[20px]', label: 'Stack' },
			{ value: 'v0.9 en pruebas', valueClass: 'text-[20px]', label: 'Estado' },
		]}
	/>

	<section class="section-pad py-[6vw]">
		<div class="grid gap-11" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));">
			<div>
				<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">01 — El problema</span>
				<h2 class="mt-3 text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">
					LOS NÚMEROS DEL CAMPO VIVEN EN PAPEL
				</h2>
				<p class="mt-5 text-[15px] leading-[1.6] text-ink-secondary">
					En muchos establecimientos, los datos de animales y pasturas se llevan en cuadernos, planillas sueltas o en la cabeza del productor. Cruzar esa información para tomar una decisión toma tiempo que casi nunca sobra.
				</p>
				<p class="mt-4 text-[15px] leading-[1.6] text-ink-secondary">
					Cuando el dato no está a mano, la decisión se posterga o se toma a ojo. Eso tiene un costo directo en la producción.
				</p>
			</div>
			<div>
				<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">02 — La decisión de producto</span>
				<h2 class="mt-3 text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">
					CARGAR POCO, PROYECTAR MUCHO
				</h2>
				<p class="mt-5 text-[15px] leading-[1.6] text-ink-secondary">
					eTool apuesta a un ingreso de <strong class="font-semibold text-ink">datos</strong> mínimo: lo justo para que la app pueda calcular. El productor carga animales, pasturas y suplementos una sola vez y los actualiza cuando cambian.
				</p>
				<p class="mt-4 text-[15px] leading-[1.6] text-ink-secondary">
					A cambio, la app devuelve <strong class="font-semibold text-ink">proyecciones</strong>: consumo y disponibilidad en el tiempo, para anticipar cuándo va a faltar pastura o suplemento antes de que sea un problema.
				</p>
			</div>
		</div>
	</section>

	<section class="section-pad pb-[6vw]">
		<div class="grid gap-[22px]" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
			<ImageFrame ratio="9/19" label="Pantalla: acceso" />
			<ImageFrame ratio="9/19" label="Pantalla: datos" />
			<ImageFrame ratio="9/19" label="Pantalla: animales" />
			<ImageFrame ratio="9/19" label="Pantalla: proyecciones" />
		</div>
	</section>

	<section class="section-pad border-t-2 border-white/[0.22] py-[6vw]">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">LOS CUATRO MÓDULOS</h2>
			<span class="pb-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">03 — Qué hace</span>
		</div>
		<div class="grid gap-px bg-white/[0.16]" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
			{
				modulos.map((m) => (
					<div class="bg-base p-7">
						<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">{m.num}</span>
						<h3 class="mt-2 text-[20px] font-extrabold uppercase tracking-[-0.02em]">{m.title}</h3>
						<p class="mt-3 text-[15px] leading-[1.6] text-ink-secondary">{m.desc}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="section-pad border-t-2 border-white/[0.22] py-[6vw]">
		<div class="grid gap-11" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));">
			<div>
				<span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-silver-muted">04 — Construcción</span>
				<h2 class="mt-3 text-[clamp(28px,4vw,52px)] font-extrabold uppercase tracking-[-0.035em]">
					DECISIONES TÉCNICAS QUE SOSTIENEN EL PRODUCTO
				</h2>
			</div>
			<div>
				{
					decisiones.map((d, i) => (
						<div
							class:list={[
								'py-5',
								i !== 0 && 'border-t border-white/[0.16]',
							]}
						>
							<p class="text-[15px] leading-[1.6] text-ink-secondary">
								<strong class="font-semibold text-ink">{d.strong}</strong>
								{d.rest}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<CtaClose
		heading="¿TENÉS UN PRODUCTO EN ESTA ETAPA?"
		paragraph="Si tu proyecto se parece a este problema, hablemos de cómo resolverlo."
		primaryLabel={`Enviar consulta →`}
		primaryHref="/contacto"
		secondaryLabel="Ver servicios"
		secondaryHref="/servicios"
	/>

	<Footer />
</Layout>
